{
    "name": "C++ Template Development",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "developer",
            "USER_UID": "1000", // Podman 환경에선 명시적 숫자가 안전할 때가 많습니다
            "USER_GID": "1000"
        },
        "options": [
            "--format", "docker"
        ]
    },

    "remoteUser": "developer",
    "workspaceFolder": "/home/developer/workspace",
    
    "runArgs": [
        "--privileged",
        "--net=host",
        "--shm-size=2gb",
        "--gpus=all",
        "--device=/dev/dri:/dev/dri",
        "--userns=keep-id",
        "-e", "DISPLAY=${localEnv:DISPLAY}",
        "-v", "${localWorkspaceFolder}:${containerWorkspaceFolder}:Z",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix:rw"
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-azuretools.vscode-containers"
            ]
        }
    },

    // 컨테이너 실행 전
    "initializeCommand": "xhost +local:podman"
}
